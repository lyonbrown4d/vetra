{
  "name": "vetra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "tsc -b",
    "build-storybook": "node scripts/run-storybook-build.mjs",
    "clean": "pnpm -r clean",
    "dev": "pnpm --filter vetra-playground dev",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:e2e": "node scripts/run-playwright-with-server.mjs tests/e2e",
    "test:perf": "node scripts/run-playwright-with-server.mjs tests/performance",
    "test:storybook": "node scripts/run-storybook-tests.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.tools.json --noEmit --pretty"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css,scss,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@lexical/react": "^0.29.0",
    "@playwright/test": "^1.52.0",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test-runner": "^0.22.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "lexical": "^0.29.0",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^8.6.14",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
