{
  "name": "@vetra/blocks-basic",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.tsx",
      "import": "./src/react.tsx"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "pwsh -NoProfile -Command \"Remove-Item -Recurse -Force dist, tsconfig.tsbuildinfo -ErrorAction SilentlyContinue\""
  },
  "dependencies": {
    "@vetra/core": "workspace:*",
    "@vetra/lexical": "workspace:*",
    "@vetra/react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
