{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    ".storybook/**/*.ts",
    "eslint.config.mjs",
    "playwright.config.ts",
    "scripts/**/*.mjs",
    "stories/**/*.ts",
    "stories/**/*.tsx",
    "tests/**/*.ts",
    "vitest.config.ts",
    "packages/**/tests/**/*.ts",
    "packages/**/tests/**/*.tsx",
    "packages/**/vite.config.ts",
    "*.config.cjs",
    "*.config.mjs"
  ]
}
